# Griffin binds to localhost only by default. Do not expose it to the public internet without hardening.
GRIFFIN_HOST=127.0.0.1
GRIFFIN_PORT=8080

# Optional independent metasearch backend. Set this to your own SearXNG URL or a trusted instance.
# Example: https://your-searxng.example
SEARXNG_URL=

# Optional Brave Search API key. Keep real keys in your local .env file only.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
